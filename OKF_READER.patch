+@media(max-width:767px){.okf-reader {display:block}.okf-navigation {height:100%;border:0}.okf-reading {display:none;height:100%;padding:20px 22px 48px}.okf-reader.show-article .okf-navigation {display:none}.okf-reader.show-article .okf-reading {display:block}.okf-mobile-browse {display:block}.okf-article-content>h1 {font-size:28px}.okf-reader-toolbar {margin-bottom:24px}.workspace-nav {gap:16px}}
