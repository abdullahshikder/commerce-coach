# Local API (PostgreSQL is required; see README for setup).
PORT=4010
HOST=127.0.0.1
DATABASE_URL=postgresql://coach_runtime:REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD@127.0.0.1:5432/commerce_coach
AUTH_DATABASE_URL=postgresql://coach_login:REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD@127.0.0.1:5432/commerce_coach
APP_ORIGINS=http://localhost:4010,http://localhost:8010
# Production uses Secure, HttpOnly cookies and requires HTTPS (localhost is supported by modern browsers).
# COOKIE_SECURE=true
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Compose only. Use different random URL-safe passwords, at least 20 characters each.
POSTGRES_PASSWORD=
COACH_DB_PASSWORD=
COACH_AUTH_PASSWORD=
# Owner credentials are provided ONLY to migration/admin commands, not the web service.
# MIGRATION_DATABASE_URL=postgresql://coach_owner:...@127.0.0.1:5432/commerce_coach

# Optional Google OpenID Connect; all three values are required. Server-only secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4010/api/auth/google/callback

# Exact reverse-proxy IPs/CIDRs only. Empty means forwarded IP headers are ignored.
TRUSTED_PROXIES=
