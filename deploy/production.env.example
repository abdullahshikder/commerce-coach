# Pin the exact image digest produced by your trusted CI build.
COACH_IMAGE=ghcr.io/abdullahshikder/commerce-coach@sha256:REPLACE_WITH_64_HEX_CHARACTERS
COACH_DOMAIN=coach.example.com
COACH_TLS_SECRET=commerce-coach-tls
GOOGLE_SSO_ENABLED=false

# Match the target exactly; deployment aborts if the active context differs.
KUBE_CONTEXT=production-cluster
CONFIRM_PRODUCTION=commerce-coach:production-cluster

# Adapt these to the production cluster and ingress controller.
INGRESS_CLASS=nginx
INGRESS_NAMESPACE=ingress-nginx
TRUSTED_PROXIES=10.0.0.0/8

# Restrict database egress to the managed PostgreSQL network.
DATABASE_EGRESS_CIDR=10.40.0.0/16
DATABASE_EGRESS_PORT=5432
