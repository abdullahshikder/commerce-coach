 .signin-form .bg-white {background:var(--surface)}
 .signin-form .bg-red-600 {background:var(--accent);color:var(--surface)}
 @media(max-width:767px) {.signin-layout {display:block}.signin-story {padding:24px;border-right:0;border-bottom:1px solid var(--line)}.signin-story>div:not(.signin-wordmark),.signin-story>small {display:none}.signin-form-area {padding:36px 24px}}
+
+.empty-state {padding:40px 24px;max-width:560px;margin:24px auto;color:var(--text);text-align:center}
+.empty-state h3 {font-size:18px;font-weight:500;letter-spacing:-.3px;margin-bottom:8px}
+.empty-state p {font-size:14px;line-height:1.7;color:var(--muted);max-width:400px;margin:0 auto}
+.empty-state-action {margin-top:16px}
+.empty-state-action button {padding:8px 14px;border:1px solid var(--line);border-radius:8px;font-size:13px;font-weight:500;color:var(--text);background:var(--surface)}
+.empty-state-action button:hover {background:var(--surface-hover)}
+.empty-state-compact {padding:20px 10px;margin:0;text-align:left}
+.empty-state-compact h3 {font-size:13px;letter-spacing:0;margin-bottom:6px}
+.empty-state-compact p {font-size:12px;line-height:1.6}
+.history-list .empty-state-action button {width:auto;padding:6px 10px;border:1px solid var(--line)}
